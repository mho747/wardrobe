# Copy this file to .env. Never commit the real .env file.
OPENAI_API_KEY=

# Optional: server-only OpenAI Admin key for the read-only Costs view.
# Never use your normal project key here and never expose this value to the browser.
OPENAI_ADMIN_API_KEY=
OPENAI_COSTS_PROJECT_ID=

OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Safe default: only expose Wardrobe on the machine running Docker.
# Set this locally to a trusted LAN address only when you intentionally want LAN access.
WARDROBE_BIND_ADDRESS=127.0.0.1
WARDROBE_HOST_PORT=4173

# Persistent host paths. Relative defaults work on ordinary Docker hosts.
# Server and NAS users can override these locally with their own absolute paths.
WARDROBE_DATA_HOST_PATH=./data
WARDROBE_BACKUP_HOST_PATH=./backups
WARDROBE_UPDATE_STATE_HOST_PATH=./update-state
WARDROBE_CANDIDATES_ROOT=./candidates

# Set by deployment tooling when applicable.
WARDROBE_REVISION=

# Container-internal paths; normally leave these unchanged.
WARDROBE_DATA_DIR=/app/data
WARDROBE_MODEL_REFERENCE=/app/data/model-reference.png

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Read-only update check. Override this only when deploying a different fork.
GITHUB_REPOSITORY_URL=https://github.com/mho747/wardrobe.git
GITHUB_BRANCH=main
UPDATE_CHECK_INTERVAL_SECONDS=86400
